# ─── Supabase ─────────────────────────────────────────────────────────────
# Required. App throws at startup if these are missing.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=hola@inventagency.co

# ─── WhatsApp (Evolution API) ─────────────────────────────────────────────
# Required by /api/whatsapp/send (returns 500 if not set)
EVOLUTION_API_KEY=...
EVOLUTION_INSTANCE=Invent

# ─── Webhook secrets (REQUIRED — endpoints fail closed if not set) ────────
# Generate strong random values:  openssl rand -hex 32
TELEGRAM_WEBHOOK_TOKEN=replace-with-random-32-byte-hex
SYNC_SECRET=replace-with-random-32-byte-hex

# ─── OpenClaw / Sincronía (optional) ──────────────────────────────────────
OPENCLAW_API_URL=
OPENCLAW_API_KEY=

# ─── Yumk public diagnostic ────────────────────────────────────────
# Comma-separated additional origins. The two production Yumk URLs are
# already allowed in code; use this for future custom domains.
YUMK_ALLOWED_ORIGINS=
