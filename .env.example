# Variables de entorno necesarias para el CRM Invent

# Supabase - Variables públicas (se usan en el frontend)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publico

# Supabase - Service Role (solo backend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreto

# Resend - Servicio de emails
RESEND_API_KEY=re_tu_api_key

# Email remitente (opcional, default: hola@inventagency.co)
FROM_EMAIL=hola@inventagency.co

# Secret para sincronización webhook (seguridad entre servicios)
SYNC_SECRET=tu-secret-aleatorio-largo
